{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      ".read": "auth != null",
      "$uid": {
        "$connection": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isBoolean() && newData.val() === true"
        }
      }
    }
  }
}
